package com.example.policy;

// Generated by RuleForge. Do not edit by hand; regenerate from policy.

declare ClaimRequest
    memberAge : int
    diagnosisCodes : java.util.List
    conservativeTherapyWeeks : int
    symptomDurationWeeks : int
    monthsSinceLastLumbarMri : int
    newNeuroDeficit : boolean
    providerNetwork : String
end

declare Decision
    outcome : String
    reasonCode : String
    ruleId : String
end

rule "R1: Urgent red-flag diagnosis"
    // source: "MRI of the lumbar spine is approved without further review when the request includes a diagnosis of cauda equina syndrome (G83.4), suspected vertebral metastasis (C79.51), or vertebral osteomyelitis (M46.2)."
    salience 100
    activation-group "policy-decision"
when
    $c : ClaimRequest( (diagnosisCodes contains "G83.4" || diagnosisCodes contains "C79.51" || diagnosisCodes contains "M46.2") )
then
    insert(new Decision("APPROVE", "URGENT_INDICATION", "R1"));
end

rule "R3: Repeat MRI within 12 months without new deficit"
    // source: "A request is denied when the member had a lumbar MRI within the past 12 months, unless the request documents a new neurological deficit."
    salience 50
    activation-group "policy-decision"
when
    $c : ClaimRequest( (monthsSinceLastLumbarMri < 12 && newNeuroDeficit == false) )
then
    insert(new Decision("DENY", "REPEAT_IMAGING_NOT_INDICATED", "R3"));
end

rule "R2: Pediatric member"
    // source: "Requests for members under 18 years of age are pended for review by a pediatric radiologist."
    salience 10
    activation-group "policy-decision"
when
    $c : ClaimRequest( memberAge < 18 )
then
    insert(new Decision("PEND_REVIEW", "PEDIATRIC_RADIOLOGY_REVIEW", "R2"));
end

rule "R4: Routine low back pain meets criteria"
    // source: "For non-urgent low back pain, MRI is approved when the member is 18 or older, has completed at least 6 weeks of conservative therapy, and has had symptoms for at least 6 weeks."
    salience 10
    activation-group "policy-decision"
when
    $c : ClaimRequest( (memberAge >= 18 && conservativeTherapyWeeks >= 6 && symptomDurationWeeks >= 6) )
then
    insert(new Decision("APPROVE", "ROUTINE_CRITERIA_MET", "R4"));
end

rule "R5: Insufficient conservative therapy"
    // source: "Requests where the member has completed fewer than 6 weeks of conservative therapy are denied."
    salience 10
    activation-group "policy-decision"
when
    $c : ClaimRequest( conservativeTherapyWeeks < 6 )
then
    insert(new Decision("DENY", "CONSERVATIVE_THERAPY_INSUFFICIENT", "R5"));
end

rule "R6: Out-of-network ordering provider"
    // source: "Requests from out-of-network ordering providers are pended for network review."
    salience 10
    activation-group "policy-decision"
when
    $c : ClaimRequest( providerNetwork == "OUT" )
then
    insert(new Decision("PEND_REVIEW", "NETWORK_REVIEW", "R6"));
end
